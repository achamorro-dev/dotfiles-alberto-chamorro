[user]
    name = Alberto Chamorro
    email = a.chamorro.ruiz@gmail.com
	signingkey = /Users/alberto/.ssh/id_ed25519_sign.pub
[credential]
    helper = osxkeychain
[alias]
    c = commit -m
    s = status
    l = log
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/alberto/.ssh/allowed_signers
[commit]
	gpgsign = true
