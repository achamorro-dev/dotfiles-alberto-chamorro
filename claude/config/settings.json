{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__resolve-library-id",
      "Bash(find:*)",
      "Bash(grep:*)",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_linear_linear__list_users",
      "mcp__plugin_linear_linear__list_issue_labels",
      "mcp__linear-server__get_issue",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run:*)",
      "Bash(md5:*)",
      "Bash(openspec new:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions proposal:*)",
      "Bash(openspec instructions design:*)",
      "Bash(openspec:*)",
      "Bash(./scripts/cli.sh:*)",
      "Bash(flutter test *)",
      "Bash(fvm flutter *)",
      "Bash(gh pr *)",
      "mcp__pencil"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/alberto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ste100@codely": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "codely": {
      "source": {
        "source": "github",
        "repo": "CodelyTV/agent-harness"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "agentPushNotifEnabled": true
}
